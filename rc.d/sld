#!/bin/ksh
#
# sld forks itself. rc waits for that parent to exit.
# rc.subr replaces pexp with the daemon path. Set the title after
# that so a start records "sld: parent". Stop reads the recorded
# pattern back, so check sets it again.

daemon="/usr/local/sbin/sld"
daemon_flags="-c /etc/sl.conf"
daemon_user="_sl"

. /etc/rc.d/rc.subr

pexp="sld: parent"

rc_check() {
	pexp="sld: parent"
	pgrep -T "${daemon_rtable}" -q -xf "${pexp}"
}

rc_configtest() {
	rc_exec "${daemon} -n -c /etc/sl.conf"
}

rc_cmd $1
