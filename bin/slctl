#!/usr/bin/perl

use strict;
use warnings;
use FindBin;
BEGIN {
	my $lib = "$FindBin::Bin/../lib";
	if (-f "$lib/SLMON.pm") {
		require lib;
		lib->import($lib, "$FindBin::Bin/../blib");
	}
}

use SLMON ();
use SLMON::Config;
use SLMON::Parent;

$SLMON::PROG = 'slctl';

sub usage {
	die <<"END";
usage: slctl init|passwd|status|top|once [-c file] [-d db] [-l host:port]
END
}

my $cmd = shift @ARGV;
usage() if !defined $cmd || $cmd =~ /\A-/;

my ($file, $db, $listen);
while (@ARGV) {
	my $arg = shift @ARGV;
	if ($arg eq '-c') {
		$file = shift @ARGV;
		die SLMON::err('-c needs a path') if !defined $file;
	} elsif ($arg eq '-d') {
		$db = shift @ARGV;
		die SLMON::err('-d needs a path') if !defined $db;
	} elsif ($arg eq '-l') {
		$listen = shift @ARGV;
		die SLMON::err('-l needs host:port') if !defined $listen;
	} else {
		die SLMON::err("unknown argument $arg");
	}
}

if ($cmd eq 'init' || $cmd eq 'passwd') {
	my $refused = SLMON::Parent::init_refused($>, $cmd);
	die "$refused\n" if $refused;
}

my $cfg = SLMON::Config::load_file($file);
SLMON::Config::apply_paths($cfg,
	db_path => $db,
	listen  => $listen,
);
$cfg->{_file} = $file if defined $file && $file ne '';

if ($cmd eq 'init') {
	SLMON::Parent::run($cfg, init_only => 1);
} elsif ($cmd eq 'passwd') {
	my $how = SLMON::Parent::run($cfg, passwd_only => 1);
	exit($how eq 'reset' ? 0 : 1);
} elsif ($cmd eq 'status') {
	exit SLMON::Parent::status($cfg);
} elsif ($cmd eq 'top') {
	exit SLMON::Parent::top($cfg);
} elsif ($cmd eq 'once') {
	exit SLMON::Parent::once($cfg);
} else {
	usage();
}

exit 0;
